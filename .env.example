# PostgreSQL
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=meshpay_admin
POSTGRES_HOST_PORT=5433

# Shared HS256 secret for issuing/validating bridge JWTs (>= 32 bytes)
JWT_SECRET=your_jwt_secret_at_least_32_bytes_long

# Base64 PKCS#8 RSA private key consumed by ingestion-service packet decryption
# (Day 13). The matching public key is what bridges encrypt packets with.
MESH_CRYPTO_PRIVATE_KEY=your_base64_pkcs8_private_key


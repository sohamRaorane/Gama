# Copy this file to .env and fill in real secrets
# Keep the .env file out of version control

# Database credentials (must match POSTGRES_USER/PASSWORD in root .env)
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# RSA private key used by the ingestion service to decrypt mesh packets
# (Day 13: HybridCryptoService.decrypt, invoked only after the Redis idempotency
# claim and the freshness check both succeed).
# Format: base64-encoded PKCS#8 DER, single line, no PEM headers.
# Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out receiver.pem
#   openssl pkcs8 -topk8 -nocrypt -in receiver.pem -outform DER | base64 -w0
# The matching PUBLIC key is what senders encrypt with. Never commit the private key.
MESH_CRYPTO_PRIVATE_KEY=your_base64_pkcs8_private_key
